# Copy to .env and fill in real values:  cp .env.example .env
# .env is git-ignored — never commit real credentials.

# --- Db2 connection -------------------------------------------------------
DB2_HOST=localhost
DB2_PORT=50000
DB2_DATABASE=sample
DB2_USER=db2inst1
DB2_PASSWORD=your-db2-password

# --- Embeddings -----------------------------------------------------------
# No API keys: embeddings are generated by a LOCAL llama.cpp server
# (bge-small-en-v1.5) via Db2's PROVIDER OPENAI model. The endpoint/model are
# set directly in scripts/1_ingest.sql. See docs/local-embeddings.md.

# --- Object names (optional; defaults shown) ------------------------------
DB2_SCHEMA=myschema
DB2_TABLE=chunks

# --- Db2 instance owner (for local text-search admin / shell wrappers) ----
DB2_INSTANCE_OWNER=db2inst1

# --- Hybrid fusion knobs (optional; defaults shown) -----------------------
# Tune against `DB2_HOST=local python scripts/eval.py`. VEC_GATE drops the vector
# leg when its best cosine similarity is below this (e.g. exact error codes embed
# to noise). Re-tune after changing the embedding model.
HYBRID_W_LEX=0.5
HYBRID_W_VEC=0.5
HYBRID_VEC_GATE=0.30
HYBRID_LEX_GATE=0.0
HYBRID_POOL=50

# --- Query understanding (scripts/query-understanding) --------------------
# smart_search() always applies the extractive lexical cleaner (pure SQL, no LLM).
# Generative expansion via local Qwen is gated by QU_MODE and OFF by default.
#   off = cleaner only (no LLM) | gated = route gate | crag = confidence gate
QU_MODE=off
QU_SIM_GATE=0.60

# --- Reranking (post-fusion cross-encoder, Search tab only) ---------------
# App-layer stage on top of Db2 fusion; OFF by default. Needs a reranker server
# (llama-server --reranking on RERANK_URL). See scripts/rerank/.
RERANK_ON=0
RERANK_URL=http://127.0.0.1:8087
RERANK_MODEL=reranker
RERANK_N=20
RERANK_K=3
RERANK_TIMEOUT=8.0
