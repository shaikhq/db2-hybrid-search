# --- Secrets: never commit real credentials ---
# NOTE: `.env.*` is the rule that was missing — a `.env.bak.*` copy slipped past a
# bare `.env` rule and published a live Db2 password to GitHub.
.env
.env.*
!.env.example
*.key
*.pem
*credentials*
*secret*

# --- Backups / editor & session junk ---
*.bak
*.bak.*
*.orig
*.rej
*~
*.swp
.idea/
.vscode/
.claude/

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/
dist/
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Runtime / generated artifacts ---
cache/
*.npy
*.gguf
out/
scratch/
tmp/
*.log
logs/

# Generated build residue — rebuild with ui/build_fixtures.sh / build_eval_set.sh.
# The PUBLISHED copies under ui/static/ ARE tracked: they power the offline demo.
/ui/fixtures.json
/ui/eval_set.json

# --- Iteration ledger (scripts/iterate) ---
# The PNG + .txt snapshots under iterations/ ARE tracked on purpose: they are the
# before/after record, and reviewing them in the diff is the whole point. Videos are
# megabytes each and regenerable, and index.html is a generated view of meta.json.
iterations/**/*.webm
iterations/index.html

# Local-only working artifacts (kept on disk, never shipped).
backup/
QA_REPORT.md

# --- OS noise ---
.DS_Store
Thumbs.db
